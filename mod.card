-- Sharing metadata, read by tooling and the manager detail pane only.
return {
  summary = "Fork of Paperboi's Useful Bag for Gen 1-3. Gen 1: 999 item slots in six auto-sorted pockets. Gen 2/3: 999-slot pockets and item PC, sorting, battle-aware pockets.",
  author = "Tooandorisu",
  contact = "https://github.com/Tooandorisu/multigen-bag",
  tags = { "inventory", "bag", "quality-of-life" },
  differences = {
    changed = {
      "bag capacity 20 -> 999 distinct item slots",
      "bag and PC item stacks 99 -> 999",
    },
    added = {
      "six auto-sorted pockets (ITEMS, MEDICINE, POKé BALLS, TMs / HMs, BATTLE ITEMS, KEY ITEMS) cycled with LEFT/RIGHT, wrapping at both ends",
      "a hidden bag (the flat inventory) underneath the pockets so key items keep working no matter which pocket the bag was closed on",
      "battle-aware pockets: the in-battle bag opens on BATTLE ITEMS and skips TMs / HMs and KEY ITEMS when cycling",
      "the POKé FLUTE is in BATTLE ITEMS in battle and KEY ITEMS in the overworld",
      "the last battle pocket is remembered for the current runtime session",
      "TAB / R3 while the bag is open sorts it by name or by count",
      "touchscreen SELECT while the bag is open opens the sort prompt",
      "the bag cursor wraps around at the first/last item",
      "Gen 2 / Gen 3: ITEM, BALL and KEY ITEM pockets (and Gen 3's BERRY POUCH) hold 999 different items",
      "Gen 2 / Gen 3: START sorts the open pocket by name, count or item number",
      "Gen 2: SORT row in the item menu (NAME / QTY / NO.)",
      "Gen 2: battle PACK skips pockets with nothing usable in battle",
      "Gen 2 / Gen 3: the item PC holds 999 entries",
      "Gen 3 FRLG / Emerald: the bag cursor wraps between the first item and CANCEL",
    },
    known = {
      "legacy Gen 1 raw save imports/exports still read at most 20 bag items and cap quantities at 99",
      "Gen 2 and Gen 3 keep their native stack sizes (x99, x999 in FRLG)",
    },
  },
  credits = {
    { name = "Paperboi (ShaneMcGovernIE)", role = "original Useful Bag (Gen 1)",
      url = "https://github.com/ShaneMcGovernIE/useful-bag" },
  },
  compat = { engine = ">=1.0.0 <2.0.0", modApi = 2 },
}
